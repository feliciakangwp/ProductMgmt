{
  "name": "productflow-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @productflow/api & npm run dev --workspace @productflow/web",
    "dev:web": "npm run dev --workspace @productflow/web",
    "dev:api": "npm run dev --workspace @productflow/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "bash supabase/tests/run.sh",
    "lint": "prettier --check .",
    "test:e2e": "npm run test:e2e --workspace @productflow/e2e",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
