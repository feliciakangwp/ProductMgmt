# Browser configuration for the ProductFlow AI web app. Copy to apps/web/.env.local.
# Only public values belong here: anything prefixed VITE_ is shipped to the browser.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Leave empty in development: Vite proxies /api to the API server (see vite.config.ts).
VITE_API_BASE_URL=
