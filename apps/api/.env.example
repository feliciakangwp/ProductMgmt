# Server-side configuration for the ProductFlow AI API.
# Copy to apps/api/.env. Never commit the real file.

PORT=8787
HOST=127.0.0.1
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Same values as the web app's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Service role key: lets the API write delivery records (stories, sprints, UAT, defects) after
# checking the caller's project role. Server-side only; never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key. Only the API server reads this; it is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANALYSIS_EFFORT=medium

# Optional: also serve the built web app (npm run build --workspace @productflow/web) from this server.
# WEB_ROOT=../web/dist
