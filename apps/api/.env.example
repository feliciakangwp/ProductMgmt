# Server-side configuration for the ProductFlow AI API.
# Copy to apps/api/.env. Never commit the real file.

PORT=8787
HOST=127.0.0.1
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Same values as the web app's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Anthropic API key. Only the API server reads this; it is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANALYSIS_EFFORT=medium
